+# ALM conditioning channel (Stage 3).
+#
+# ChemGraph["alm_embedding"] is a (K * llm_hidden_dim,) = (32768,) float32 vector
+# per structure: the K=8 Qwen3-8B hidden states at the [atoms_i] output token
+# positions for the text prompt, concatenated. This default pool bridge
+# (bridge.AtomsMapper, about 9M params) reshapes it to (B, K, hidden_dim),
+# projects each position, and mean-pools over K to (B, 512). The other
+# bridge_kind values in the Stage 3 trainer swap in a sequence-capable bridge.
+# The gradient of L_diff flows back through the bridge into the LLM.
+#
+# GemNetTAdapter.__init__ rewrites unconditional_embedding_module to
+# ZerosEmbedding, so the choice here does not matter; EmbeddingVector matches
+# the other property_embeddings YAMLs.
+_target_: mattergen.property_embeddings.PropertyEmbedding
+name: alm_embedding
+unconditional_embedding_module:
+  _target_: mattergen.property_embeddings.EmbeddingVector
+  hidden_dim: ${lightning_module.diffusion_module.model.hidden_dim}
+# bridge.AtomsMapper is imported by bare module name, so src/alm must be on
+# PYTHONPATH for mattergen-finetune / mattergen-generate and on checkpoint load:
+#   PYTHONPATH=<repo>/src/alm:$PYTHONPATH mattergen-finetune ...
+conditional_embedding_module:
+  _target_: bridge.AtomsMapper
+  hidden_dim: 4096   # Qwen3-8B hidden dim; input shape (B, K*hidden_dim) flattens to (B, K, hidden_dim)
+  mid_dim: 2048      # bottleneck inside the per-position MLP
+  out_dim: ${lightning_module.diffusion_module.model.hidden_dim}
+  K: 8
+scaler:
+  _target_: torch.nn.Identity
